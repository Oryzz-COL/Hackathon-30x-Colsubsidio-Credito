# Todas las variables son opcionales. Sin ellas la aplicación funciona completa:
# Chispy responde con su motor local y los correos quedan en la bandeja interna.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Chispy ────────────────────────────────────────────────────────────────
# Clave de Google AI Studio (https://aistudio.google.com/apikey). Tiene capa
# gratuita, y flash-lite es el modelo más barato con llamada a funciones.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Controles de gasto y abuso de la URL pública.
# CHISPY_ENABLED=false        Apaga el modelo; Chispy sigue respondiendo local.
# CHISPY_LIMITE_DIARIO=250    Techo de consultas con modelo por día e instancia.

# Proveedores compatibles para el copiloto.
LLM_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.7-plus

# ── Correos ───────────────────────────────────────────────────────────────
# Sin estas dos variables los correos se generan y se muestran dentro de la
# aplicación sin salir a internet, que es el comportamiento seguro por defecto.
# Con ellas se envían de verdad por Resend (https://resend.com/api-keys).
RESEND_API_KEY=
NOTIFICACIONES_FROM=
# Destinatario que representa al equipo asesor en el entorno de ejemplo.
ASESOR_DEMO_EMAIL=asesor@creasy.demo

# Voz opcional. Solo sintetiza respuestas ya anonimizadas del copiloto.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Supabase opcional. La clave secreta nunca debe llevar NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

DATA_RETENTION_DAYS=90
MAX_BATCH_ROWS=2000
MAX_UPLOAD_BYTES=5000000
